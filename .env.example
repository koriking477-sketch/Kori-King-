# Public Supabase configuration (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
# New-style publishable key. If omitted, NEXT_PUBLIC_SUPABASE_ANON_KEY is used.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only configuration. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: extra lock on admin sign-in. The account must also exist in the
# `admin_members` table, which is the source of truth for admin access.
ADMIN_EMAIL=

# Optional: secret used to hash rate-limit keys and temporary hold tokens.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
RATE_LIMIT_SECRET=
